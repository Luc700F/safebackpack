# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and must never be committed.
#
# The same variables go into the Vercel project settings for deployment.
# Never paste a real secret into a chat, an issue, or a commit.

# --- Email delivery (Resend) ------------------------------------------------
# Create at https://resend.com/api-keys with "Sending access" only.
RESEND_API_KEY=

# The address verification emails are sent from.
# safebackpack.app was verified with Resend on 2026-08-19, so mail reaches any
# recipient. This mailbox does not receive; hello@safebackpack.app is the
# address people write to.
EMAIL_FROM=no-reply@safebackpack.app

# --- Signing ----------------------------------------------------------------
# Signs the token that keeps a verified reporter recognised for 30 days.
# Generate with: openssl rand -base64 32
RECOGNITION_SECRET=

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string from Supabase:
#   Project Settings -> Database -> Connection string -> URI
# Take the "Session pooler" variant, and replace [YOUR-PASSWORD] with the
# database password you chose when creating the project.
DATABASE_URL=

# A SEPARATE database for the database tests. They empty tables between cases,
# so pointing them at the one above destroys its contents — the tests refuse to
# run if the two are the same. Leave empty to skip them.
TEST_DATABASE_URL=

# --- Abuse limits (Upstash Redis) -------------------------------------------
# Counters have to live somewhere every serverless instance can see. Without
# these two, limits are counted in memory and a platform that starts a fresh
# instance per request effectively has no limits at all.
# From the Upstash console: your database -> REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Scheduled jobs -----------------------------------------------------------
# Vercel sends this with every scheduled request; nothing else knows it.
# Without it the retention endpoint refuses everyone, including the scheduler,
# and reports are never anonymised. Generate with: openssl rand -base64 32
CRON_SECRET=

# --- Moderation ---------------------------------------------------------------
# OpenAI's moderation endpoint reads reports for abuse, threats and hate — the
# judgement the patterns cannot make. Free and unmetered: it does not count
# against usage limits. Without it the patterns are the whole of the screening.
# From platform.openai.com -> API keys.
OPENAI_API_KEY=

# One password for the one person who moderates, at /admin. Not an account
# system: building one to serve a single person would be a lot of surface area
# for no benefit. Without it the moderation screen refuses everyone, and held
# reports stay invisible to everybody.
ADMIN_PASSWORD=

# --- Public ------------------------------------------------------------------
# The site's own origin, used to build links inside verification emails.
# Locally this stays localhost; in Vercel it is https://safebackpack.app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
