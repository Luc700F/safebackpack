{
  "name": "safebackpack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "email:test": "tsx scripts/send-test-email.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "test:db": "tsx scripts/with-env.ts npx vitest run src/lib/reports/postgres-repository src/lib/geo/postgis-country-locator",
    "db:build-boundaries": "tsx scripts/build-country-boundaries.ts",
    "db:seed-countries": "tsx scripts/seed-countries.ts",
    "db:seed-demo": "tsx scripts/seed-demo-reports.ts",
    "maplibre:worker": "tsx scripts/copy-maplibre-worker.ts",
    "predev": "npm run maplibre:worker",
    "prebuild": "npm run maplibre:worker"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "maplibre-gl": "^6.9.0",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
