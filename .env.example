# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and must never be committed.
#
# The same variables go into the Vercel project settings for deployment.
# Never paste a real secret into a chat, an issue, or a commit.

# --- Email delivery (Resend) ------------------------------------------------
# Create at https://resend.com/api-keys with "Sending access" only.
RESEND_API_KEY=

# The address verification emails are sent from.
# Until safebackpack.app is verified with Resend, this can only be
# onboarding@resend.dev, and it can only deliver to the address the Resend
# account was registered with. Once the domain is verified, use
# no-reply@safebackpack.app.
EMAIL_FROM=onboarding@resend.dev

# --- Signing ----------------------------------------------------------------
# Signs the token that keeps a verified reporter recognised for 30 days.
# Generate with: openssl rand -base64 32
RECOGNITION_SECRET=

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string from Supabase:
#   Project Settings -> Database -> Connection string -> URI
# Take the "Session pooler" variant, and replace [YOUR-PASSWORD] with the
# database password you chose when creating the project.
DATABASE_URL=

# --- Public ------------------------------------------------------------------
# The site's own origin, used to build links inside verification emails.
# Locally this stays localhost; in Vercel it is https://safebackpack.app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
